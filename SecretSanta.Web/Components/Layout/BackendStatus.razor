@using System.Diagnostics
@implements IDisposable
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Navigation
@inject ILogger<BackendStatus> Logger

@* Backend connection indicator – pings the API on page load and navigation, click to re-check.
   After a failure it retries every 10 s, which also keeps waking up a sleeping API (Render free tier). *@

<button type="button" class="backend-status @CssClass" title="@Tooltip" aria-live="polite" @onclick="PingAsync">
    <span class="status-dot"></span>
    <span class="status-label">@Label</span>
</button>

@code {
    private enum State { Checking, Online, DatabaseDown, Offline }

    private State status = State.Checking;
    private long? latencyMs;
    private string? failureReason;
    private bool pinging;
    private readonly CancellationTokenSource disposed = new();
    private static readonly TimeSpan RetryDelay = TimeSpan.FromSeconds(10);

    private record PingResponse(string Status, bool Database);

    private string CssClass => status switch
    {
        State.Online => "is-online",
        State.DatabaseDown => "is-warning",
        State.Offline => "is-offline",
        _ => "is-checking"
    };

    private string Label => status switch
    {
        State.Online => L["StatusOnline"],
        State.DatabaseDown => L["StatusDbDown"],
        State.Offline => L["StatusOffline"],
        _ => L["StatusChecking"]
    };

    private string Tooltip => status switch
    {
        State.Offline when failureReason is not null => $"{Label} · {failureReason}",
        _ when latencyMs is not null => $"{Label} · {L["StatusLatency", latencyMs]}",
        _ => Label
    };

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnLocationChanged;
        await PingAsync();
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
        => _ = InvokeAsync(PingAsync);

    private async Task PingAsync()
    {
        if (pinging)
        {
            return;
        }

        pinging = true;
        // Keep showing "online" during a re-check; only the first check / a failed state shows "checking"
        if (status != State.Online)
        {
            status = State.Checking;
            latencyMs = null;
            StateHasChanged();
        }

        var stopwatch = Stopwatch.StartNew();
        try
        {
            var client = HttpClientFactory.CreateClient("apiservice");
            var response = await client.GetFromJsonAsync<PingResponse>("api/ping", disposed.Token);
            latencyMs = stopwatch.ElapsedMilliseconds;
            failureReason = null;
            status = response?.Database == true ? State.Online : State.DatabaseDown;
        }
        catch (OperationCanceledException) when (disposed.IsCancellationRequested)
        {
            return; // page closed
        }
        catch (Exception e)
        {
            failureReason = e switch
            {
                HttpRequestException { StatusCode: not null } http => $"HTTP {(int)http.StatusCode.Value}",
                Polly.Timeout.TimeoutRejectedException => "timeout",
                Polly.CircuitBreaker.BrokenCircuitException => "circuit open",
                _ => e.GetBaseException().Message
            };
            Logger.LogWarning(e, "Backend ping failed after {ElapsedMs} ms: {Reason}", stopwatch.ElapsedMilliseconds, failureReason);
            latencyMs = null;
            status = State.Offline;
        }
        finally
        {
            pinging = false;
        }

        StateHasChanged();

        if (status != State.Online)
        {
            ScheduleRetry();
        }
    }

    private void ScheduleRetry() => _ = Task.Run(async () =>
    {
        try
        {
            await Task.Delay(RetryDelay, disposed.Token);
            await InvokeAsync(PingAsync);
        }
        catch (OperationCanceledException)
        {
            // page closed
        }
    });

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        // Cancel only (no Dispose) – a retry still in flight may read the token afterwards
        disposed.Cancel();
    }
}

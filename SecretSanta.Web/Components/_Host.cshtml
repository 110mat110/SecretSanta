@page "/"
@using Microsoft.AspNetCore.Components.Web
@namespace SecretSanta.Web.Components
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using System.Globalization

<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="~/" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,600;0,9..144,700;1,9..144,600&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    <link href="app.css" rel="stylesheet" asp-append-version="true" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <meta name="theme-color" content="#faf6f0" />
</head>
<body>

    <component type="typeof(SecretSanta.Web.Components.App)" render-mode="Server" />

    <div id="blazor-error-ui">
        <environment include="Staging,Production">
            An error has occurred. This application may no longer respond until reloaded.
        </environment>
        <environment include="Development">
            An unhandled exception has occurred. See browser dev tools for details.
        </environment>
        <a href="" class="reload">Reload</a>
        <a class="dismiss">🗙</a>
    </div>

    <script src="js/app.js" asp-append-version="true"></script>
    <script src="_framework/blazor.server.js"></script>
</body>
</html>
